[user]
	name = DongHyeok Kim
	email = dhkim@bookswage.com

[core]
	fileMode = false
	autocrlf = false

[alias]
	st = status
	co = checkout
	br = branch
	lg = log --oneline --graph --decorate --all

[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true
	side-by-side = true

[diff]
	colorMoved = default

[pull]
	rebase = false

[init]
	defaultBranch = main
