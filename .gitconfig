[user]
	name = DongHyeok Kim
	email = ucceoum@gmail.com

[core]
	autocrlf = false
	pager = delta

[alias]
	st = status
	co = checkout
	br = branch
	lg = log --oneline --graph --decorate --all

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true
	side-by-side = true

[pull]
	rebase = false

[init]
	defaultBranch = main

[include]
	path = ~/.gitconfig.local
